#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D prevFrame;
layout(binding = 1) uniform sampler2D currFrame;
layout(binding = 2, rgba8) uniform writeonly image2D outFrame;
layout(push_constant) uniform PushData { float t; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outFrame);
    if (p.x >= size.x || p.y >= size.y) return;
    vec4 a = texelFetch(prevFrame, p, 0);
    vec4 b = texelFetch(currFrame, p, 0);
    imageStore(outFrame, p, mix(a, b, clamp(pc.t, 0.0, 1.0)));
}
